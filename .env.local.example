# Copy this file to .env.local and fill in the values from the Clerk dashboard
# (https://dashboard.clerk.com → your app → API Keys).

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Optional comma-separated Clerk user IDs authorized for the demo driver dashboard
CABBOOK_DRIVER_USER_IDS=

# Optional same-origin WebSocket ticket signing key; defaults to CLERK_SECRET_KEY
NOTIFICATION_WS_SECRET=

# Generate these with `npm run push:vapid`; keep the private key in runtime secrets only.
# Push alerts are disabled until all three values are configured.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com/ItsPinion/uber-clone
